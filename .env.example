# Application Settings
APP_NAME="Autonomous Code & Analysis Workspace"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"
# Tried in order when the primary model is overloaded (503), rate-limited (429),
# times out (504) or is retired (404). Keep at least one lighter model here.
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite"
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Docker Sandbox Settings
DOCKER_SANDBOX_IMAGE="python:3.11-slim"
EXECUTION_TIMEOUT_SECONDS=30
MAX_CONTAINER_MEMORY="512m"
CPU_QUOTA_MICROS=100000

# LangGraph Guardrails
MAX_ITERATIONS=5

